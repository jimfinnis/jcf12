#!/bin/sh

ip=$(ip -o -4 addr show enp0s8 | awk '{print $4}' | cut -d/ -f1)

echo Binding to $ip

#hugo server --bind 192.168.1.102 -b http://192.168.1.102:1313/
#hugo server --bind 192.168.142.3 -b http://192.168.142.3:1313/
#hugo server --bind 10.0.2.15 -b http://10.0.2.15:1313/
hugo server --bind $ip -b http://$ip:1313/
